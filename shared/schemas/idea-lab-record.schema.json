{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumiverse-toolkit.idea-lab/v1",
  "type": "object",
  "required": ["schema", "project_id", "route", "brief", "candidates", "comparison", "selected_candidate_id", "validation"],
  "properties": {
    "schema": {"const": "lumiverse-toolkit.idea-lab/v1"},
    "project_id": {"type": ["string", "null"]},
    "route": {"enum": ["direct", "variants", "interview", "anti_generic", "combine"]},
    "brief": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "direction_signature", "premise", "foundation", "deviation", "scene_engine", "recurring_pressure", "world_motion", "player_positions", "agency_risks", "divergence_dimensions", "artifact_profile"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["provisional", "approved", "rejected"]},
          "direction_signature": {"type": "string", "minLength": 1},
          "premise": {"type": "string", "minLength": 1},
          "foundation": {"type": "string", "minLength": 1},
          "deviation": {"type": "string", "minLength": 1},
          "scene_engine": {"type": "string", "minLength": 1},
          "recurring_pressure": {"type": "string", "minLength": 1},
          "world_motion": {"type": "string", "minLength": 1},
          "player_positions": {"type": "array", "items": {"type": "string"}},
          "agency_risks": {"type": "array", "items": {"type": "string"}},
          "divergence_dimensions": {"type": "array", "items": {"type": "string"}},
          "artifact_profile": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "comparison": {"type": "array"},
    "selected_candidate_id": {"type": ["string", "null"]},
    "validation": {"type": "object"}
  },
  "additionalProperties": true
}
